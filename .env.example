# Existing authenticated case service (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Use a persistent volume. SQLite supports one shared-volume service instance;
# use a shared database/object store before scaling to multiple machines.
LOCKX_DATA_DIR=/data/lockx

# Optional image analysis. Choose an available vision model with JSON support.
# Photos are sent to OpenAI only when BOTH values are set.
OPENAI_API_KEY=
LOCKX_VISION_MODEL=

# Optional inbound MMS. Configure this exact HTTPS URL in Twilio as a POST hook.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
LOCKX_MMS_NUMBER=
LOCKX_MMS_WEBHOOK_URL=https://YOUR-API-HOST/api/v1/lost-found/webhooks/twilio
